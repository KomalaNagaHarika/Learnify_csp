# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Optional external backend base URL when frontend is deployed statically (e.g. on Vercel).
# Leave empty when serving frontend and backend from the same origin.
VITE_API_BASE_URL=""

# ALLOWED_ORIGINS: Optional comma-separated list of frontend origins allowed by Express CORS middleware.
ALLOWED_ORIGINS="https://learnify-csp.vercel.app"
